# Copy this to .env and fill in real values.
# .env is gitignored. Never commit real keys.

# Anthropic (Claude) API key. Used for all reasoning, summarization, and composition.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Perplexity API key. Used for public web research on each person.
# Get one at https://www.perplexity.ai/settings/api
# Free tier is plenty for a single run.
PERPLEXITY_API_KEY=

# Google OAuth credentials path. Defaults to ./credentials.json if unset.
# This file is what you downloaded from Google Cloud Console (Desktop client).
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Where to cache the OAuth token after first run. Defaults to ./token.json.
GOOGLE_TOKEN_PATH=./token.json

# How many people to feature in the final output. Default is 10.
TOP_N_PEOPLE=10

# How far back to look for ranking signal. The pipeline scans recent emails
# to identify important people, then pulls full history per person.
# 90 days captures most active relationships while keeping first-run
# ingestion under ~15 min. Bump to 180 if you want to catch quarterly-cadence
# collaborators at the cost of a slower first run.
RANKING_WINDOW_DAYS=90

# Hard cap on emails ingested per person during deep history pull.
# Prevents one prolific contact (e.g. a noisy mailing list that slipped
# through the filter) from blowing up the run.
MAX_EMAILS_PER_PERSON=200

