# Secrets and credentials. None of these ever get committed.
.env
.env.local
credentials.json
token.json
*.token
client_secret*.json

# SQLite cache and generated outputs. Regenerable, no value in version control.
data/
output/
*.db
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / Vite
node_modules/
dist/
.vite/

# OS noise
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Backup files that might accidentally hold real secrets
*.backup
*.bak
*.orig

# Demo corpus generation. The committed fixture is the corpus itself
# (demo/threads/, demo/*.json). The machinery that produced it is not:
# raw model output, the prompts used for a given run, and cost logs are
# run artifacts, not source.
demo/.generated/
demo/**/*.raw.json
demo/*.cost.log
demo/the_read.json

# Agent/editor tool config. Local to whoever is working, same as .vscode
# or .idea. The launch config in here is a convenience, not part of the
# project's build.
.claude/
